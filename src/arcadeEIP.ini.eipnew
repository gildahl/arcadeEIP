;==============================================================================================================
;Configuration file template, arcadeEIP.ini generated by arcadeEIP, v.0.4.2.1.
;A fresh copy of this file (arcadeEIP.ini) may be created by using -createcfg at a command prompt.
;You may also create a verbose instructional version of this file (with comments) by using -createcfgexample
;==============================================================================================================

[General]
debug_mode=off
status_beeps=0
alpha_effect=1
sound_device=Default
sync_volume=0
show_license=1
hotstring_prefix=@!@
seed_rom=mame galaga.zip

[Marquee]
active=0
monitor=2
exit_key=^!x
autostart=0
autoexit=0
interpolation=7
show_high_scores=1
fade_effect=1
poll_frequency=80
window_left=0
window_top=0
window_height=0
window_width=0

[Picker_Preferences]
kiosk_mode=1
magic_delay=2000
mark_picks=1
joy_vert=all
joy_horiz=all
mouse_vert=off
mouse_horiz=off
default_list=
all_picks_label=Picks
top_picks_label=Picks
hide_systems=
clean_lists=0
font_type=Tahoma
list_font_size=14
list_margin=0
game_font_size=40
system_font_size=30
game_name_ratio=0.4
asset_name=EIP_Picker
;run_apps=ultramap
;whitelist=mame qbert.zip, mame congo.zip

[Key_Map]
;General Keys
panic_key=>^>!k
lock_game_key=+
scorecard_key=;
pause_key=,
menu_toggle_key='
menu_show_key==
menu_hide_key=-
quit_key=~
exit_key=.
magic_key=.
previous_key=[
next_key=]

;Game Menu Keys
launch_key=LCtrl
list_view_key=v
add_remove_key=Enter
edit_mode_key=e
left_key=Left
right_key=Right
up_key=Up
down_key=Down
pgup_key=PgUp,LAlt
pgdn_key=PgDn,Space
sgup_key=1
sgdn_key=2
home_key=Home,5
end_key=End,6

;Game Marking Keys
favorite_key=m
star_key=s
star0_key=
star1_key=
star2_key=
star3_key=
star4_key=
star5_key=

;Bulk game copy/delete keys
all_key=a
favorites_key=f
rating_key=r
genre_key=g
year_key=y
publisher_key=p
developer_key=d
players_key=n

[XInput]
use_xinput=1
invert_page_buttons=0
start_a=menu
start_b=pause
start_x=scorecard

[Scorecard]
take_screenshots=1
use_watermark=1

[Auto_Switch]
folder=Lists\autoswitch
auto=20
mute=0
delay=120
timer=5
random=1
pause_lock=0

[Integration]
import_favorites=0
import_user_ratings=0
import_community_ratings=0

[List_autoswitch]
list_key=autoswitch
proper_name=Auto-Switch
sort_prefix=

;[List_golden]
;list_key=golden
;proper_name=Golden Age
;sort_prefix=

[Front_End_os]
fe_key=os
asset_name=windows
proper_name=Windows
hide_cursor=0
hide_taskbar=1
start_screen=1
exit_screen=1
show_on_pause=highscore,native,controls,info
;run_apps=
;magic_delay=2000
;kiosk_mode=1

;[Front_End_bigbox]
;fe_key=bigbox
;proper_name=BigBox
;asset_name=BigBox
;window_name=LaunchBox Big Box
;exe_full_path=C:\Launchbox\BigBox.exe
;start_screen=1
;exit_screen=1
;show_on_pause=highscore,native,controls,info
;hide_cursor=1
;hide_taskbar=0
;magic_delay=2000
;kiosk_mode=0
;run_apps=ultramap,winipac

;[Front_End_gameex]
;fe_key=gameex
;proper_name=GameEx
;asset_name=GameEx
;exe_full_path=C:\GameEx\GameEx.exe
;start_screen=1
;exit_screen=1
;show_on_pause=highscore,native,controls,info
;hide_cursor=1
;hide_taskbar=0
;magic_delay=2000
;kiosk_mode=0
;run_apps=ultramap,winipac

[Image_Preferences]
img_top_left=
img_top_right=
img_logo_left=system_logo
img_logo_right=logo,system_logo
img_center_left=system_controls
img_center_right=system_banner
switching_regions=
switch_timer=5

;===========================================================================
;Example console settings with LaunchBox (or your own defined assets). Copy these
;into individual console [System] sections if you would like these to be system specific.
;===========================================================================
;img_top_left=box3d,boxback
;img_top_right=cartfront,boxfront
;img_logo_left=system_logo
;img_logo_right=logo,system_logo
;img_center_left=system_banner
;img_center_right=snap,title,highscore
;switching_regions=top_left,center_right
;switch_timer=5

;===========================================================================
;Example arcade settings with LaunchBox (or your own defined assets). Copy these
;into individual arcade [System] sections if you would like these to be system specific.
;===========================================================================
;img_top_left=cabinet
;img_top_right=boxfront,adfront,adback
;img_logo_left=system_logo
;img_logo_right=logo,system_logo
;img_center_left=controlpanel,controls,system_controls
;img_center_right=snap,title,highscore
;switching_regions=top_right,center_right
;switch_timer=5

metrics_top_left=0.9,0.0
metrics_top_right=0.9,0.0
metrics_logo_left=0.9,0.0
metrics_logo_right=0.9,0.0
metrics_center_left=0.9,0.0
metrics_center_right=0.9,0.0

[Global_Assets]
;===========================================================================
;These types are built-in and should NOT be changed
;===========================================================================
meta_names=.\Assets\[asset_name]\Meta\Names\.meta
highscore_folder=.\Assets\[asset_name]\HighScore\Rom

;===========================================================================
;These types are built-in and MUST point to valid paths.
;You may, however, redirect them to point at other valid folder locations.
;===========================================================================
system_banner=.\Assets\[asset_name]\banner.png
logo_folder=.\Assets\[asset_name]\Logo\Rom
system_logo=.\Assets\[asset_name]\Logo\System\[asset_name].png
marquee_folder=.\Assets\[asset_name]\Marquee\Rom
system_marquee=.\Assets\[asset_name]\Marquee\System\[asset_name].png
controls_folder=.\Assets\[asset_name]\Controls
system_controls=.\Assets\[asset_name]\controls.png

;===========================================================================
;These examples show the above built-in types redirected to point at equivalent LaunchBox asset folders.
;If integrating with LB, at least the logo_folder and/or marquee_folder MUST point at a LaunchBox images folder.
;Also insure asset_name (or alternate_asset_name) in [System] sections are assigned to the LB *platform* name.
;Alternately, you may copy these settings to appropriate [System] sections and hard-code the paths.
;Uncommenting these will override the settings above.
;===========================================================================
;system_banner=D:\LaunchBox\Images\Platforms\[alternate_asset_name]\Banner\[alternate_asset_name].png
;logo_folder=D:\LaunchBox\Images\[alternate_asset_name]\Clear Logo
;system_logo=D:\LaunchBox\Images\Platforms\[alternate_asset_name]\Clear Logo\[alternate_asset_name].png
;marquee_folder=D:\LaunchBox\Images\[alternate_asset_name]\Arcade - Marquee
;system_marquee=D:\LaunchBox\Images\Platforms\[alternate_asset_name]\Clear Logo\[alternate_asset_name].png
;controls_folder=D:\LaunchBox\Images\[alternate_asset_name]\Arcade - Controls Information
;system_controls=.\Assets\[asset_name]\Controls\controls.png

;===========================================================================
;These are examples of ad hoc types that can be used to assign images to the game select screen.
;(i.e. top_left, top_right, center_left, and center_right), and/or show_on_pause
;These are not required and folders are not validated unless used in one of those locations.
;Feel free to add more, change these paths as necessary, and/or copy them into [System] sections.
;===========================================================================
snap_folder=D:\LaunchBox\Images\[alternate_asset_name]\Screenshot - Gameplay
title_folder=D:\LaunchBox\Images\[alternate_asset_name]\Screenshot - Game Title
adfront_folder=D:\LaunchBox\Images\[alternate_asset_name]\Advertisement Flyer - Front
adback_folder=D:\LaunchBox\Images\[alternate_asset_name]\Advertisement Flyer - Back
cabinet_folder=D:\LaunchBox\Images\[alternate_asset_name]\Arcade - Cabinet
circuit_folder=D:\LaunchBox\Images\[alternate_asset_name]\Arcade - Circuit Board
controlpanel_folder=D:\LaunchBox\Images\[alternate_asset_name]\Arcade - Control Panel
box3d_folder=D:\LaunchBox\Images\[alternate_asset_name]\Box - 3D
boxfront_folder=D:\LaunchBox\Images\[alternate_asset_name]\Box - Front
boxback_folder=D:\LaunchBox\Images\[alternate_asset_name]\Box - Back
cart3d_folder=D:\LaunchBox\Images\[alternate_asset_name]\Cart - 3D
cartfront_folder=D:\LaunchBox\Images\[alternate_asset_name]\Cart - Front
cartback_folder=D:\LaunchBox\Images\[alternate_asset_name]\Cart - Back
banner_folder=D:\LaunchBox\Images\[alternate_asset_name]\Banner

[System_mame]
sys_key=mame
asset_name=MAME
proper_name=Arcade
sort_prefix=
autoswitch=1
exe_full_path=D:\Emulators\MAME\mame.exe,min
window_name=[[rom_name]]
search_path=[root_folder]\roms\*.zip
;search_path=[root_folder]_*\roms\*.zip
param_list=[rom_name] -nowindow -joy -skip_gameinfo -autosave -nosleep -priority 1 -keyboardprovider dinput <-video,1>
;rule_1=<change_root> [root_folder]_* <if_rom_in_subfolder> \roms
;rule_2=<use_proxy> [rom_name].txt <if_in_folder> [root_folder]\roms
use_hi2txt=0
clean_lists=1
map_pause={toggle}p
map_exit={Event}{Esc}
;map_exit={CloseActive}
;run_apps=ultramap,winipac
;pause_apps=
mameinfo_folder=.\Assets\MAME\Meta\Info
;logo_folder=D:\LaunchBox\Images\Arcade\Clear Logo
;system_logo=D:\LaunchBox\Images\Platforms\Arcade\Clear Logo\Arcade.png
;marquee_folder=D:\LaunchBox\Images\Arcade\Arcade - Marquee
;snap_folder=D:\LaunchBox\Images\Arcade\Screenshot - Gameplay
;titles_folder=D:\LaunchBox\Images\Arcade\Screenshot - Game Title
;controls_folder=D:\LaunchBox\Images\Arcade\Arcade - Controls Information
;meta_names=C:\GameEx\DATA\MAME.map

;[System_coleco]
;sys_key=coleco
;asset_name=Coleco_Vision
;proper_name=Colecovision
;sort_prefix=
;exe_full_path=D:\Emulators\MAME\mame.exe,min
;window_name=ColecoVision
;search_path=[root_folder]_*\software\coleco\*.rom
;param_list=coleco -cart "[rom]" -joy -now -skip_gameinfo -keyboardprovider dinput <-video,1>
;run_apps=ultramap,winipac
;rule_1=<change_root> [root_folder]_* <if_rom_in_subfolder> \software\coleco
;rule_2=<use_proxy> [rom_name].txt <if_in_folder> [root_folder]\software\coleco
;map_pause={toggle}p
;map_exit={Event}{Esc}

;[Application_ultramap]
;app_key=ultramap
;proper_name=Ultramap
;exe_full_path=C:\Program Files (x86)\UltraMap\UltraMap.exe
;profile=D:\Profiles\UltraStick\[asset_name]\[smart_name].ugc
;param_list="[profile]"

;[Application_winipac]
;app_key=winipac
;proper_name=WinIPAC
;exe_full_path=C:\Program Files (x86)\WinIPAC V2\WinIPAC.exe
;profile=D:\Profiles\WinIPAC\[asset_name]\[smart_name].ipc
;param_list="[profile]"

;[Application_joytokey]
;app_key=joytokey
;proper_name=JoyToKey
;exe_full_path=D:\Utilities\JoyToKey\JoyToKey.exe,nowait
;profile=D:\Utilities\JoyToKey\[asset_name]_[smart_name].cfg
;param_list="[profile]"
